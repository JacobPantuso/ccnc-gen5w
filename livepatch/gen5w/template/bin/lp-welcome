#!/system/bin/sh
# DRAFT / UNTESTED ON A HEAD UNIT.
# NEMESIS LivePatch exec tool: lp-welcome <in> <out>. Puts the ccNC startup video (Kia or Hyundai, by the car)
# into a copy of the stock welcome app: every stock Hyundai/Kia res/raw/welcome_* video is replaced; the
# manifest, resources and META-INF stay byte-for-byte. Exit 0: written; 10: nothing to replace (already ccNC's
# videos, which are all under 1 MB, or an unknown app), left as it is.
in="$1"; out="$2"
# Result for ccNC's developer menu (best effort): /data/ccnc/livepatch/<step> = applied | unsupported
mark() {
    mkdir -p /data/ccnc/livepatch 2>/dev/null && chmod 755 /data/ccnc /data/ccnc/livepatch 2>/dev/null
    echo "$2" > "/data/ccnc/livepatch/$1" 2>/dev/null && chmod 644 "/data/ccnc/livepatch/$1" 2>/dev/null
    return 0
}
[ -s files/patch.jar ] || { echo "lp-welcome: missing files/patch.jar"; exit 1; }
[ -r "$in" ] || { echo "lp-welcome: cannot read $in"; exit 1; }
is_kia() {
    case "$(getprop ro.build.product)" in CVEV*) return 0;; CEEV*|NEEV*) return 1;; esac
    case "$(getprop ro.product.brand)" in *kia*|*kmc) return 0;; esac
    return 1
}
V=files/welcome_hyundai.mp4
is_kia && [ -f files/welcome_kia.mp4 ] && V=files/welcome_kia.mp4
[ -s "$V" ] || { echo "lp-welcome: missing $V"; exit 1; }
# Only the brand videos (welcome_hyundai* / welcome_kia*), by exact name: never others such as welcome_disney_*.
# Stock ones are over 1 MB; the rest are 5-byte stubs, and ccNC's are under 1 MB (so a patched copy is left as it is).
size_of() { set -- $(ls -l "$1" 2>/dev/null); echo "$4"; }
mine="$(size_of files/welcome_hyundai.mp4) $(size_of files/welcome_kia.mp4)"
real=0; ours=0; args=""
app_process -Djava.class.path=files/patch.jar /system/bin dev.ccnc.welcome.Patch list "$in" > "$PWD/lp-welcome.list" 2>/dev/null
while read size name; do
    case "$name" in
    res/raw/welcome_hyundai*.mp4|res/raw/welcome_kia*.mp4)
        [ "$size" -gt 1000000 ] 2>/dev/null && { real=$((real + 1)); args="$args $name=$V"; }
        case " $mine " in *" $size "*) ours=$((ours + 1)) ;; esac ;;
    esac
done < "$PWD/lp-welcome.list"
rm -f "$PWD/lp-welcome.list"
[ $real -eq 0 ] && [ $ours -gt 0 ] && { mark welcome applied; echo "lp-welcome: already ccNC's video"; exit 10; }
[ $real -gt 0 ] || { mark welcome unsupported; echo "lp-welcome: no stock welcome video in $in; left as it is"; exit 10; }
rm -f "$out"
app_process -Djava.class.path=files/patch.jar /system/bin dev.ccnc.welcome.Patch "$in" "$out" $args >/dev/null 2>&1
rc=$?
[ $rc -eq 0 ] && [ -s "$out" ] && { mark welcome applied; echo "lp-welcome: $real video(s) -> ${V#files/}"; exit 0; }
rm -f "$out"
mark welcome unsupported
echo "lp-welcome: couldn't build the patched app (rc $rc); left stock"
exit 10
