<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.ccnc.navi"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-permission android:name="android.permission.GET_TASKS" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="com.hkmc.permission.ACCESS_NAVIGATION" />

    <uses-permission android:name="android.permission.BLUETOOTH"/>
    <application android:name="dev.ccnc.common.CcncApp"
        android:label="Navigation"
        android:icon="@drawable/ic_launcher"
        android:theme="@style/NaviTheme"
        android:hardwareAccelerated="true"
        android:allowBackup="false">

        <activity
            android:name=".MainActivity"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:configChanges="mcc|mnc|orientation|screenSize|keyboardHidden|keyboard|navigation|locale|layoutDirection|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ccNC search (own keyboard: the unit's IME is stock-styled) and POI categories. -->
        <activity
            android:name=".SearchActivity"
            android:launchMode="singleTop"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:windowSoftInputMode="stateAlwaysHidden"
            android:configChanges="mcc|mnc|orientation|screenSize|keyboardHidden|keyboard|navigation|locale|layoutDirection|uiMode" />
        <activity
            android:name=".CategoriesActivity"
            android:launchMode="singleTop"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:configChanges="mcc|mnc|orientation|screenSize|keyboardHidden|keyboard|navigation|locale|layoutDirection|uiMode" />

        <!-- The stock engine's sticky destination broadcast: each destination it starts becomes a ccNC recent. -->
        <receiver android:name=".DestinationReceiver">
            <intent-filter>
                <action android:name="com.mnsoft.navi.action.DestinationInfo" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
