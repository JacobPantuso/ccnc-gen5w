[nemesis]
version=1.1
id=ccnc.climatebtn.restore
name=ccNC Climate Buttons Restore
type=application
package-version=@VERSION@
short-desc="Puts the previous HKMC_Climate.odex back (emergency restore)."
detailed-desc="ccNC Climate Buttons Restore @VERSION@: writes back the HKMC_Climate.odex this unit had before ccNC Climate Buttons. Use with NEMESIS.emergency if Android is down. Restart afterwards."
os=any
models=any
postinstall=scripts/post.sh
