[nemesis]
version=1.1
id=ccnc.volume.restore
name=ccNC Volume Restore
type=application
package-version=@VERSION@
short-desc="Puts the stock Gen5W volume file back (emergency restore)."
detailed-desc="ccNC Volume Restore @VERSION@: writes the stock automotive-service.odex back, for when the unit doesn't start after ccNC Volume. Use with NEMESIS.emergency if Android is down. Restart afterwards."
os=any
models=any
postinstall=scripts/post.sh
